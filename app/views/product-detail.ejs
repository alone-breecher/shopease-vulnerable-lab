<div class="container my-5">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/products">Products</a></li>
      <li class="breadcrumb-item"><%= product.category %></li>
      <li class="breadcrumb-item active"><%= product.name %></li>
    </ol>
  </nav>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="card shadow-sm">
        <img src="<%= product.image_url %>" class="product-detail-img p-4" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/img/placeholder.svg'">
      </div>
    </div>
    <div class="col-md-6">
      <span class="category-badge mb-3"><%= product.category %></span>
      <h1 class="fw-bold mb-3"><%= product.name %></h1>
      <div class="mb-4">
        <span class="price-tag" style="font-size: 2.5rem;">₹<%= product.price.toLocaleString('en-IN') %></span>
      </div>
      <p class="lead text-muted mb-4"><%= product.description %></p>

      <div class="card mb-4 border-0 bg-light">
        <div class="card-body">
          <h6 class="fw-bold mb-3">Product Details</h6>
          <ul class="list-unstyled mb-0">
            <li class="mb-2"><i class="bi bi-box-seam text-primary me-2"></i> Category: <strong><%= product.category %></strong></li>
            <li class="mb-2">
              <% if (product.stock > 0) { %>
                <i class="bi bi-check-circle-fill text-success me-2"></i>
                <span class="text-success"><strong>In Stock</strong> (<%= product.stock %> available)</span>
              <% } else { %>
                <i class="bi bi-x-circle-fill text-danger me-2"></i>
                <span class="text-danger"><strong>Out of Stock</strong></span>
              <% } %>
            </li>
            <li class="mb-2"><i class="bi bi-truck text-primary me-2"></i> Free Delivery across India</li>
            <li><i class="bi bi-shield-check text-primary me-2"></i> 1 Year Warranty</li>
          </ul>
        </div>
      </div>

      <div class="row g-3 align-items-end">
        <div class="col-auto">
          <label class="form-label fw-semibold">Quantity:</label>
          <input type="number" id="quantity" class="form-control form-control-lg" value="1" min="1" max="<%= product.stock %>" style="width: 100px;">
        </div>
        <div class="col">
          <button class="btn btn-primary btn-lg px-5" onclick="addToCart(<%= product.id %>)" <%= product.stock === 0 ? 'disabled' : '' %>>
            <i class="bi bi-cart-plus"></i> Add to Cart
          </button>
        </div>
      </div>

      <div class="mt-4">
        <button class="btn btn-outline-secondary me-2">
          <i class="bi bi-heart"></i> Add to Wishlist
        </button>
        <button class="btn btn-outline-secondary">
          <i class="bi bi-share"></i> Share
        </button>
      </div>
    </div>
  </div>

  <% if (related.length > 0) { %>
    <hr class="my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="fw-bold mb-0">You May Also Like</h3>
    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
      <% related.forEach(p => { %>
        <div class="col">
          <div class="card h-100 shadow-sm">
            <img src="<%= p.image_url %>" class="product-img" alt="<%= p.name %>" onerror="this.onerror=null;this.src='/img/placeholder.svg'">
            <div class="card-body">
              <h6 class="card-title"><%= p.name %></h6>
              <p class="price-tag" style="font-size: 1.25rem;">₹<%= p.price.toLocaleString('en-IN') %></p>
            </div>
            <div class="card-footer bg-white border-0 pt-0">
              <a href="/product/<%= p.id %>" class="btn btn-outline-primary w-100">View Details</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<script>
  function addToCart(productId) {
    const quantity = document.getElementById('quantity').value;

    fetch('/cart/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ product_id: productId, quantity: parseInt(quantity) })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        alert('Product added to cart successfully!');
        location.reload();
      } else {
        alert('Error: ' + data.message);
      }
    })
    .catch(err => {
      alert('Failed to add product to cart');
    });
  }
</script>
