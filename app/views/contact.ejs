<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us - ShopEase</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
    <div class="container">
      <a class="navbar-brand fw-bold text-primary" href="/products">
        <i class="bi bi-bag-check-fill"></i> ShopEase
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link" href="/products">Products</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/contact">Contact</a>
          </li>
        </ul>
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/cart">
              <i class="bi bi-cart3"></i> Cart
            </a>
          </li>
          <% if (user) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle"></i> <%= user.name %>
              </a>
              <ul class="dropdown-menu" aria-labelledby="userDropdown">
                <li><a class="dropdown-item" href="/orders">My Orders</a></li>
                <% if (user.role === 'admin') { %>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="/zevon-admin">Admin Panel</a></li>
                <% } %>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/logout">Logout</a></li>
              </ul>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/login">Login</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/register">Register</a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container my-5">
    <div class="row">
      <div class="col-md-8 mx-auto">
        <h1 class="mb-4">Contact Us</h1>

        <% if (success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>

        <div class="card">
          <div class="card-body p-4">
            <form method="POST" action="/contact">
              <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" name="name" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Subject</label>
                <input type="text" name="subject" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Message</label>
                <textarea name="message" class="form-control" rows="5" required></textarea>
              </div>
              <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
          </div>
        </div>

        <div class="row mt-5">
          <div class="col-md-4">
            <div class="text-center">
              <i class="bi bi-envelope fs-1 text-primary"></i>
              <h5 class="mt-3">Email</h5>
              <p class="text-muted">support@shopease.in</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="text-center">
              <i class="bi bi-telephone fs-1 text-primary"></i>
              <h5 class="mt-3">Phone</h5>
              <p class="text-muted">1800-SHOPEASE</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="text-center">
              <i class="bi bi-clock fs-1 text-primary"></i>
              <h5 class="mt-3">Hours</h5>
              <p class="text-muted">Mon-Sat: 9AM - 6PM IST</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="bg-dark text-white mt-5 py-4">
    <div class="container">
      <div class="text-center text-muted">
        <p>&copy; 2024 ShopEase. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
