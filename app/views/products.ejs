<div class="hero-section">
  <div class="container text-center">
    <h1 class="display-4 fw-bold mb-3">Summer Mega Sale</h1>
    <p class="lead mb-4">Up to 60% OFF on Electronics - Free Delivery Across India</p>
    <div class="row justify-content-center mt-4">
      <div class="col-md-8">
        <form action="/products" method="GET" class="search-box">
          <div class="input-group">
            <input type="text" name="search" class="form-control form-control-lg" placeholder="Search for smartphones, laptops, headphones..." value="<%= search || '' %>">
            <button class="btn btn-primary" type="submit">
              <i class="bi bi-search"></i> Search
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="container my-5">
  <% if (search) { %>
    <div class="alert alert-info d-flex align-items-center">
      <i class="bi bi-search me-2"></i>
      Showing results for: <strong class="ms-1">"<%= search %>"</strong>
      <a href="/products" class="btn btn-sm btn-outline-secondary ms-auto">Clear Search</a>
    </div>
  <% } %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
      <% if (search) { %>
        Search Results
      <% } else { %>
        Featured Products
      <% } %>
    </h2>
    <span class="text-muted"><%= products.length %> products found</span>
  </div>

  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    <% products.forEach(product => { %>
      <div class="col">
        <div class="card h-100 shadow-sm position-relative">
          <% if (product.category === 'Smartphones' || product.category === 'Audio') { %>
            <span class="discount-badge">HOT</span>
          <% } %>
          <img src="<%= product.image_url %>" class="product-img" alt="<%= product.name %>" onerror="this.src='https://via.placeholder.com/300x300?text=<%= encodeURIComponent(product.name) %>'">
          <div class="card-body d-flex flex-column">
            <span class="category-badge"><%= product.category %></span>
            <h5 class="card-title"><%= product.name %></h5>
            <p class="card-text text-muted small flex-grow-1"><%= product.description.substring(0, 80) %>...</p>
            <div class="mt-auto">
              <div class="d-flex align-items-center mb-2">
                <span class="price-tag">₹<%= product.price.toLocaleString('en-IN') %></span>
              </div>
              <% if (product.stock > 0) { %>
                <span class="stock-badge bg-success text-white">
                  <i class="bi bi-check-circle-fill"></i> In Stock (<%= product.stock %>)
                </span>
              <% } else { %>
                <span class="stock-badge bg-danger text-white">
                  <i class="bi bi-x-circle-fill"></i> Out of Stock
                </span>
              <% } %>
            </div>
          </div>
          <div class="card-footer bg-white border-0 pt-0">
            <a href="/product/<%= product.id %>" class="btn btn-outline-primary w-100">
              <i class="bi bi-eye"></i> View Details
            </a>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <% if (products.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-search" style="font-size: 4rem; color: #ccc;"></i>
      <h3 class="mt-3">No products found</h3>
      <p class="text-muted">Try adjusting your search or browse all products</p>
      <a href="/products" class="btn btn-primary mt-3">View All Products</a>
    </div>
  <% } %>
</div>
