<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order #<%= order.id %> - ShopEase</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
    <div class="container">
      <a class="navbar-brand fw-bold text-primary" href="/products">
        <i class="bi bi-bag-check-fill"></i> ShopEase
      </a>
    </div>
  </nav>

  <main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1>Order #<%= order.id %></h1>
      <a href="/orders" class="btn btn-outline-secondary">Back to Orders</a>
    </div>

    <div class="row">
      <div class="col-md-8">
        <div class="card mb-3">
          <div class="card-header">
            <h5 class="mb-0">Order Items</h5>
          </div>
          <div class="card-body">
            <% items.forEach(item => { %>
              <div class="row mb-3 pb-3 border-bottom align-items-center">
                <div class="col-md-7">
                  <h6><%= item.product_name %></h6>
                  <p class="text-muted mb-0">Quantity: <%= item.quantity %></p>
                </div>
                <div class="col-md-5 text-end">
                  <p class="fw-bold mb-0">₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></p>
                </div>
              </div>
            <% }); %>
            <div class="text-end">
              <h5>Total: <span class="text-primary">₹<%= order.total.toLocaleString('en-IN') %></span></h5>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card mb-3">
          <div class="card-header">
            <h5 class="mb-0">Order Status</h5>
          </div>
          <div class="card-body">
            <% if (order.status === 'Delivered') { %>
              <span class="badge bg-success fs-6"><%= order.status %></span>
            <% } else if (order.status === 'Shipped') { %>
              <span class="badge bg-info fs-6"><%= order.status %></span>
            <% } else { %>
              <span class="badge bg-warning fs-6"><%= order.status %></span>
            <% } %>
            <p class="mt-3 mb-0">
              <small class="text-muted">Ordered on <%= new Date(order.created_at).toLocaleDateString('en-IN') %></small>
            </p>
          </div>
        </div>
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Delivery Address</h5>
          </div>
          <div class="card-body">
            <p class="mb-0"><%= order.address %></p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="bg-dark text-white mt-5 py-4">
    <div class="container">
      <div class="text-center text-muted">
        <p>&copy; 2024 ShopEase. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
