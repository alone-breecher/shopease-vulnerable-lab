<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orders - Admin - ShopEase</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
  <nav class="navbar navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/zevon-admin">
        <i class="bi bi-shield-lock-fill"></i> ShopEase Admin
      </a>
      <a href="/products" class="btn btn-outline-light btn-sm">Back to Store</a>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="row">
      <nav class="col-md-2 d-md-block bg-light sidebar py-3">
        <div class="position-sticky">
          <ul class="nav flex-column">
            <li class="nav-item">
              <a class="nav-link" href="/zevon-admin">
                <i class="bi bi-speedometer2"></i> Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/zevon-admin/users">
                <i class="bi bi-people"></i> Users
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" href="/zevon-admin/orders">
                <i class="bi bi-bag"></i> Orders
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/zevon-admin/products">
                <i class="bi bi-box"></i> Products
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/zevon-admin/messages">
                <i class="bi bi-envelope"></i> Messages
              </a>
            </li>
          </ul>
        </div>
      </nav>

      <main class="col-md-10 ms-sm-auto px-md-4 py-4">
        <h1 class="mb-4">Orders Management</h1>

        <div class="card">
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Address</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.forEach(order => { %>
                    <tr>
                      <td>#<%= order.id %></td>
                      <td><%= order.user_name %></td>
                      <td><%= order.user_email %></td>
                      <td>₹<%= order.total.toLocaleString('en-IN') %></td>
                      <td>
                        <% if (order.status === 'Delivered') { %>
                          <span class="badge bg-success"><%= order.status %></span>
                        <% } else if (order.status === 'Shipped') { %>
                          <span class="badge bg-info"><%= order.status %></span>
                        <% } else { %>
                          <span class="badge bg-warning"><%= order.status %></span>
                        <% } %>
                      </td>
                      <td><%= new Date(order.created_at).toLocaleDateString('en-IN') %></td>
                      <td><%= order.address.substring(0, 50) %>...</td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
