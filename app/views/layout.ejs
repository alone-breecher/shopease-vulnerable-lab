<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>ShopEase - Best Deals on Electronics</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Top Info Bar -->
  <div class="top-bar bg-primary text-white py-2">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6">
          <small><i class="bi bi-lightning-charge-fill"></i> Summer Sale - Up to 60% OFF on Electronics!</small>
        </div>
        <div class="col-md-6 text-md-end">
          <small>
            <i class="bi bi-telephone-fill"></i> 1800-SHOPEASE |
            <i class="bi bi-envelope-fill ms-2"></i> support@shopease.in
          </small>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/products">
        <i class="bi bi-bag-check-fill text-primary" style="font-size: 1.8rem;"></i>
        <span class="ms-2" style="font-size: 1.5rem; color: #0d6efd;">ShopEase</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto ms-4">
          <li class="nav-item">
            <a class="nav-link fw-semibold px-3" href="/products">
              <i class="bi bi-grid-3x3-gap"></i> Products
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link fw-semibold px-3" href="/contact">
              <i class="bi bi-chat-dots"></i> Contact
            </a>
          </li>
        </ul>
        <ul class="navbar-nav align-items-center">
          <li class="nav-item me-3">
            <a class="nav-link position-relative" href="/cart">
              <i class="bi bi-cart3" style="font-size: 1.3rem;"></i>
              <% if (cart && cart.length > 0) { %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                  <%= cart.length %>
                </span>
              <% } %>
            </a>
          </li>
          <% if (user) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width: 35px; height: 35px;">
                  <i class="bi bi-person-fill"></i>
                </div>
                <span class="fw-semibold"><%= user.name %></span>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                <li><a class="dropdown-item" href="/orders"><i class="bi bi-bag-check me-2"></i>My Orders</a></li>
                <% if (user.role === 'admin') { %>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item text-primary" href="/zevon-admin"><i class="bi bi-shield-lock me-2"></i>Admin Panel</a></li>
                <% } %>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
              </ul>
            </li>
          <% } else { %>
            <li class="nav-item me-2">
              <a class="btn btn-outline-primary btn-sm" href="/login">
                <i class="bi bi-person"></i> Login
              </a>
            </li>
            <li class="nav-item">
              <a class="btn btn-primary btn-sm" href="/register">
                <i class="bi bi-person-plus"></i> Register
              </a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <main>
    <%- body %>
  </main>

  <footer class="mt-5 py-5">
    <div class="container">
      <div class="row">
        <div class="col-md-4 mb-4">
          <h5 class="fw-bold mb-3">
            <i class="bi bi-bag-check-fill text-primary"></i> ShopEase
          </h5>
          <p class="text-muted">India's most trusted online electronics store. Best deals, genuine products, and fast delivery across the country.</p>
          <div class="mt-3">
            <a href="#" class="text-white me-3"><i class="bi bi-facebook" style="font-size: 1.5rem;"></i></a>
            <a href="#" class="text-white me-3"><i class="bi bi-twitter" style="font-size: 1.5rem;"></i></a>
            <a href="#" class="text-white me-3"><i class="bi bi-instagram" style="font-size: 1.5rem;"></i></a>
            <a href="#" class="text-white"><i class="bi bi-youtube" style="font-size: 1.5rem;"></i></a>
          </div>
        </div>
        <div class="col-md-2 mb-4">
          <h6 class="fw-bold mb-3">Shop</h6>
          <ul class="list-unstyled">
            <li class="mb-2"><a href="/products" class="text-decoration-none">All Products</a></li>
            <li class="mb-2"><a href="/products?search=smartphones" class="text-decoration-none">Smartphones</a></li>
            <li class="mb-2"><a href="/products?search=laptops" class="text-decoration-none">Laptops</a></li>
            <li class="mb-2"><a href="/products?search=audio" class="text-decoration-none">Audio</a></li>
          </ul>
        </div>
        <div class="col-md-3 mb-4">
          <h6 class="fw-bold mb-3">Quick Links</h6>
          <ul class="list-unstyled">
            <li class="mb-2"><a href="/contact" class="text-decoration-none">Contact Us</a></li>
            <li class="mb-2"><a href="#" class="text-decoration-none">About Us</a></li>
            <li class="mb-2"><a href="#" class="text-decoration-none">Track Order</a></li>
            <li class="mb-2"><a href="#" class="text-decoration-none">Return Policy</a></li>
          </ul>
        </div>
        <div class="col-md-3 mb-4">
          <h6 class="fw-bold mb-3">Contact Us</h6>
          <ul class="list-unstyled">
            <li class="mb-2"><i class="bi bi-envelope-fill me-2 text-primary"></i>support@shopease.in</li>
            <li class="mb-2"><i class="bi bi-telephone-fill me-2 text-primary"></i>1800-SHOPEASE</li>
            <li class="mb-2"><i class="bi bi-clock-fill me-2 text-primary"></i>Mon-Sat: 9AM-6PM IST</li>
            <li class="mb-2"><i class="bi bi-geo-alt-fill me-2 text-primary"></i>Mumbai, India</li>
          </ul>
        </div>
      </div>
      <hr class="border-secondary my-4">
      <div class="row">
        <div class="col-md-6 text-center text-md-start">
          <p class="mb-0 text-muted">&copy; 2024 ShopEase. All rights reserved.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <a href="#" class="text-decoration-none text-muted me-3">Privacy Policy</a>
          <a href="#" class="text-decoration-none text-muted me-3">Terms of Service</a>
          <a href="#" class="text-decoration-none text-muted">Shipping Info</a>
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
