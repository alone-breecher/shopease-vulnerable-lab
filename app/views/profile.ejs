<div class="container my-5">
  <div class="row">
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <% if (user.profile_picture) { %>
            <img src="/uploads/<%= user.profile_picture %>" class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;" alt="Profile">
          <% } else { %>
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 150px; height: 150px; font-size: 3rem;">
              <%= user.name.charAt(0).toUpperCase() %>
            </div>
          <% } %>
          <h5 class="fw-bold"><%= user.name %></h5>
          <p class="text-muted mb-0"><%= user.email %></p>
          <% if (user.role === 'admin') { %>
            <span class="badge bg-danger mt-2">Admin</span>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-md-9">
      <div class="card shadow-sm">
        <div class="card-header bg-white">
          <h4 class="mb-0">Profile Settings</h4>
        </div>
        <div class="card-body">
          <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success">
              <i class="bi bi-check-circle-fill me-2"></i><%- success %>
            </div>
          <% } %>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger">
              <i class="bi bi-exclamation-triangle-fill me-2"></i><%- error %>
            </div>
          <% } %>

          <!-- Profile Picture Upload -->
          <div class="mb-4">
            <h5 class="mb-3">Change Profile Picture</h5>
            <form method="POST" action="/profile/upload" enctype="multipart/form-data">
              <div class="mb-3">
                <label for="profile_picture" class="form-label">Upload New Picture</label>
                <input type="file" class="form-control" id="profile_picture" name="profile_picture" required>
                <small class="text-muted">Accepted formats: JPG, PNG, GIF (or any file type)</small>
              </div>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-upload"></i> Upload Picture
              </button>
            </form>
          </div>

          <hr>

          <!-- Profile Information -->
          <div class="mb-4">
            <h5 class="mb-3">Profile Information</h5>
            <div class="row mb-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Full Name</label>
                <input type="text" class="form-control" value="<%= user.name %>" readonly>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Email Address</label>
                <input type="text" class="form-control" value="<%= user.email %>" readonly>
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Phone Number</label>
                <input type="text" class="form-control" value="<%= user.phone || 'Not provided' %>" readonly>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Role</label>
                <input type="text" class="form-control" value="<%= user.role %>" readonly>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Address</label>
              <textarea class="form-control" rows="2" readonly><%= user.address || 'Not provided' %></textarea>
            </div>
          </div>

          <hr>

          <!-- Account Information -->
          <div class="mb-4">
            <h5 class="mb-3">Account Information</h5>
            <div class="row">
              <div class="col-md-6">
                <label class="form-label fw-semibold">User ID</label>
                <input type="text" class="form-control" value="<%= user.id %>" readonly>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Member Since</label>
                <input type="text" class="form-control" value="<%= new Date(user.created_at).toLocaleDateString() %>" readonly>
              </div>
            </div>
          </div>

          <hr>

          <!-- Danger Zone -->
          <div class="mb-3">
            <h5 class="mb-3 text-danger">Current Password</h5>
            <div class="alert alert-warning">
              <i class="bi bi-shield-exclamation me-2"></i>
              <strong>Security Notice:</strong> Your password is: <code><%= user.password %></code>
              <br><small class="text-muted">Passwords are stored in plain text (intentional vulnerability for training)</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
